{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: every screen, the updater, and the danger zone. The four panel-only commands are not granted here; the two destructive commands are granted here only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "allow-get-app-status",
    "allow-ping",
    "allow-scan-now",
    "allow-get-overview",
    "allow-set-extra-scan-folders",
    "allow-get-extra-scan-folders",
    "allow-set-schedule",
    "allow-get-schedule",
    "allow-set-alert",
    "allow-get-alert",
    "allow-set-pack",
    "allow-get-pack",
    "allow-list-rules",
    "allow-set-rule",
    "allow-add-custom-rule",
    "allow-add-nl-rule",
    "allow-evaluate-nl-rules",
    "allow-delete-custom-rule",
    "allow-import-pack",
    "allow-set-ai-config",
    "allow-get-ai-config",
    "allow-test-ai-connection",
    "allow-get-entitlement",
    "allow-set-license",
    "allow-clear-license",
    "allow-suggest-fix",
    "allow-apply-fix",
    "allow-undo-fix",
    "allow-has-backup",
    "allow-list-files",
    "allow-list-projects",
    "allow-get-file-detail",
    "allow-get-analytics",
    "allow-get-scans-digest",
    "allow-list-templates",
    "allow-apply-template",
    "allow-get-setup",
    "allow-get-effective-rules",
    "allow-get-usage-overview",
    "allow-get-project-usage",
    "allow-list-harnesses",
    "allow-reset-app-data",
    "allow-uninstall-app"
  ]
}
